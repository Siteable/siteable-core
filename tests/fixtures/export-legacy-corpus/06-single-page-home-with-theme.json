        ]
      }
    ],
    "blocks": [
      { "id": "h-1", "type": "hero", "variant": "split", "props": { "headline": "Themed", "heroImage": "https://cdn.example.com/hero.png" } }
    ],
    "theme": {
      "fontSans": "Inter",
      "fontDisplay": "Playfair Display",
      "accent": "#0f766e",
      "bg0": "#fdfdfc",
      "text0": "#1c1917",
      "radius": 6
    }
  },
  "options": null
