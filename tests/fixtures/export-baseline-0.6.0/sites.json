{
  "note": "Purpose-built input sites for the frozen 0.6.0 export baseline. Every entry is rendered by the 0.6.0 exporter and written to `<slug>.html` (single page) or `<slug>--<n>.html` (one file per page, in array order). Never regenerate the captured HTML. Content is generic placeholder text. The two-page entry deliberately carries a block type the 0.6.0 release does not know: only its second page is captured, because a later release adds that block type and this fixture then pins the bytes of every page that block does not touch.",
  "sites": [
    {
      "slug": "navbar-only",
      "note": "A navbar alone. The page carries the shared behavior script, so it is compared with the script element's text emptied on both sides and every other byte compared.",
      "config": {
        "name": "Site",
        "blocks": [
          {
            "id": "nav-1",
            "type": "navbar",
            "variant": "default",
            "props": {
              "logo": "Acme",
              "links": ["Product", "Features"],
              "ctaText": "Get Started"
            }
          }
        ]
      },
      "options": null
    },
    {
      "slug": "hero-only",
      "note": "A hero alone. No widget on the page owns a behavior, so it never carries the shared script and is compared byte for byte.",
      "config": {
        "name": "Site",
        "blocks": [
          {
            "id": "hero-1",
            "type": "hero",
            "variant": "gradient",
            "props": {
              "headline": "Baseline hero",
              "subheadline": "Frozen 0.6.0 reference",
              "primaryCta": "Start",
              "primaryCtaUrl": "https://example.com/start"
            }
          }
        ]
      },
      "options": null
    },
    {
      "slug": "navbar-faq-tabs-carousel",
      "note": "One page carrying all three existing rule groups: a navbar and a faq block (menu/faq rules), a features block rendered as tabs, and a gallery block rendered as a carousel. Compared with the script text emptied on both sides, and with the no-script block asserted unchanged — no mask and no rule strip, so a later addition that widens the no-script block is caught here.",
      "config": {
        "name": "Site",
        "blocks": [
          {
            "id": "nav-1",
            "type": "navbar",
            "variant": "default",
            "props": {
              "logo": "Acme",
              "links": ["Product", "Features"],
              "ctaText": "Get Started"
            }
          },
          {
            "id": "q-1",
            "type": "faq",
            "variant": "accordion",
            "props": {
              "title": "Questions",
              "items": [
                { "question": "What is this?", "answer": "A page with every rule group" }
              ]
            }
          },
          {
            "id": "f-1",
            "type": "features",
            "variant": "list",
            "props": {
              "title": "Features",
              "display": "tabs",
              "items": [
                { "icon": "A", "title": "First feature", "description": "The first baseline feature" },
                { "icon": "B", "title": "Second feature", "description": "The second baseline feature" },
                { "icon": "C", "title": "Third feature", "description": "The third baseline feature" }
              ]
            }
          },
          {
            "id": "g-1",
            "type": "gallery",
            "variant": "grid",
            "props": {
              "title": "Image gallery",
              "display": "carousel",
              "images": [
                { "src": "", "alt": "Image 1", "caption": "First caption" },
                { "src": "", "alt": "Image 2", "caption": "Second caption" },
                { "src": "", "alt": "Image 3", "caption": "Third caption" }
              ]
            }
          }
        ]
      },
      "options": null
    },
    {
      "slug": "two-page-filter",
